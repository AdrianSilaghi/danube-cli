pipeline {
    agent { label 'host-build' }

    options {
        skipDefaultCheckout(true)
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '10'))
    }

    parameters {
        string(name: 'SOURCE_REF', defaultValue: '', description: 'Exact release ref, for example refs/tags/v1.2.3.')
        string(name: 'SOURCE_SHA', defaultValue: '', description: 'Exact tag commit SHA from the trusted webhook.')
        booleanParam(name: 'PUBLISH_TO_NPM', defaultValue: false, description: 'Reserved for a separately reviewed publish cutover; currently fails closed.')
    }

    environment {
        NODE_IMAGE = 'node:22-bookworm@sha256:0557ac14e0d45d02ed563067b82856ca5e7aa3437fa28d98d4350ea9c3d9494a'
    }

    stages {
        stage('Validate trusted release request') {
            steps {
                script {
                    if (env.JOB_NAME != 'danube-cli-release/npm') {
                        error("This trusted pipeline cannot run as job ${env.JOB_NAME ?: 'unset'}")
                    }

                    String sourceRef = params.SOURCE_REF.trim()
                    String sourceSha = params.SOURCE_SHA.trim()
                    if (!sourceRef.startsWith('refs/tags/')) {
                        error("Release source must be a tag ref, got ${sourceRef}")
                    }
                    String tagName = sourceRef.substring('refs/tags/'.length())
                    String numericIdentifier = '(?:0|[1-9][0-9]*)'
                    String alphanumericIdentifier = '(?:[0-9]*[A-Za-z-][0-9A-Za-z-]*)'
                    String prereleaseIdentifier = "(?:${numericIdentifier}|${alphanumericIdentifier})"
                    String semverPattern = "^v${numericIdentifier}\\.${numericIdentifier}\\.${numericIdentifier}" +
                        "(?:-${prereleaseIdentifier}(?:\\.${prereleaseIdentifier})*)?" +
                        '(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$'
                    if (!tagName.matches(semverPattern)) {
                        error("Release tag must be exact SemVer, got ${tagName}")
                    }
                    if (!(sourceSha ==~ /[0-9a-fA-F]{40}/)) {
                        error("Invalid SOURCE_SHA: ${sourceSha}")
                    }

                    env.RELEASE_TAG = tagName
                    env.EXPECTED_SOURCE_SHA = sourceSha
                    env.VERIFIED_TAG_REF = "refs/tags/${tagName}"
                    env.CHECKOUT_REFSPEC = "+${sourceRef}:${env.VERIFIED_TAG_REF} +refs/heads/main:refs/remotes/origin/main"
                }
            }
        }

        stage('Checkout and verify tag') {
            steps {
                deleteDir()
                script {
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: env.VERIFIED_TAG_REF]],
                        doGenerateSubmoduleConfigurations: false,
                        extensions: [[$class: 'CloneOption', noTags: true, shallow: false]],
                        userRemoteConfigs: [[
                            url: 'https://github.com/AdrianSilaghi/danube-cli.git',
                            refspec: env.CHECKOUT_REFSPEC
                        ]]
                    ])

                    String checkedOutSha = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
                    String tagSha = sh(
                        script: "git rev-parse '${env.VERIFIED_TAG_REF}^{commit}'",
                        returnStdout: true
                    ).trim()
                    if (!checkedOutSha.equalsIgnoreCase(tagSha)) {
                        error("HEAD ${checkedOutSha} does not match tag commit ${tagSha}")
                    }
                    if (!tagSha.equalsIgnoreCase(env.EXPECTED_SOURCE_SHA)) {
                        error("Tag commit ${tagSha} does not match SOURCE_SHA ${env.EXPECTED_SOURCE_SHA}")
                    }
                    int trustedMainStatus = sh(
                        script: "git merge-base --is-ancestor '${tagSha}' 'refs/remotes/origin/main'",
                        returnStatus: true
                    )
                    if (trustedMainStatus != 0) {
                        error("Tag ${env.RELEASE_TAG} is not reachable from trusted main")
                    }

                    String packageVersion = sh(
                        script: '''
                            docker run --rm \
                                --read-only \
                                --cap-drop ALL \
                                --security-opt no-new-privileges \
                                --user "$(id -u):$(id -g)" \
                                --tmpfs /tmp:rw,exec,nosuid,size=64m \
                                --env HOME=/tmp \
                                --volume "$WORKSPACE:/workspace:ro" \
                                --workdir /workspace \
                                "$NODE_IMAGE" \
                                node -e 'const p=require("./package.json"); if(typeof p.version!=="string") process.exit(2); process.stdout.write(p.version)'
                        ''',
                        returnStdout: true
                    ).trim()
                    if ("v${packageVersion}" != env.RELEASE_TAG) {
                        error("package.json version ${packageVersion} does not match tag ${env.RELEASE_TAG}")
                    }
                }
            }
        }

        stage('Test and package dry run') {
            steps {
                sh '''
                    docker run --rm \
                        --read-only \
                        --cap-drop ALL \
                        --security-opt no-new-privileges \
                        --user "$(id -u):$(id -g)" \
                        --tmpfs /tmp:rw,exec,nosuid,size=1g \
                        --env HOME=/tmp \
                        --env CI=true \
                        --volume "$WORKSPACE:/workspace" \
                        --workdir /workspace \
                        "$NODE_IMAGE" \
                        bash scripts/jenkins/run-tests-and-pack.sh
                '''
            }
        }

        stage('Publish gate') {
            steps {
                script {
                    if (params.PUBLISH_TO_NPM) {
                        error('Publishing is disabled during the Jenkins migration; this job supports credential-free dry runs only')
                    }
                    echo 'Credential-free npm release dry run passed; publishing remains disabled.'
                }
            }
        }
    }

    post {
        always {
            deleteDir()
        }
    }
}
